# Public browser configuration: values are safe to expose only with Supabase RLS enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend-only configuration: never use a VITE_ prefix for these values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_AUTH_VERIFICATION_MODE=jwks
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGIN=http://localhost:5173

# Dedicated live-test configuration: place these in ignored .env.live-tests.local.
# Supply two controlled accounts privately; never commit their values.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
