{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{.env*,.git/**,.vercel/**,.venv/**,venv/**,node_modules/**,dist/**,src/**,public/**,tests/**,backend/tests/**,docs/**,tools/**,supabase/**,**/__pycache__/**,**/*.pyc}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/setup", "destination": "/index.html" },
    { "source": "/essentials", "destination": "/index.html" },
    { "source": "/runway", "destination": "/index.html" },
    { "source": "/purchase", "destination": "/index.html" },
    { "source": "/result", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
