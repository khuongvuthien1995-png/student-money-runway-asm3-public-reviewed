# Public browser configuration: Vite embeds these at BUILD time, never private server keys.
# Supply each environment's permitted Supabase URL and sb_publishable_ key privately.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Leave blank for same-origin /api. An external API must use HTTPS.
VITE_API_BASE_URL=

# Backend-only configuration: never use a VITE_ prefix for these values.
# Vercel supplies these at runtime; production never loads the local dotenv file.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# JWKS URL and issuer derive from SUPABASE_URL when omitted/blank.
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_AUTH_VERIFICATION_MODE=jwks
# Used only by inspect_auth/register_test_users or the explicitly selected legacy verifier.
SUPABASE_PUBLISHABLE_KEY=
# Development origin below; set an exact permitted HTTPS app origin for Preview/Production.
ALLOWED_ORIGIN=http://localhost:5173

# Dedicated live-test configuration: place these in ignored .env.live-tests.local.
# Supply two controlled accounts privately; never commit their values.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
